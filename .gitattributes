# These generated artifacts and their source snapshot are compared byte-for-byte.
# Keep identical bytes on Windows development and Linux CI checkouts.
extensions/native/access/module/models.json text eol=lf
extensions/native/access/module/manifest.json text eol=lf
data/schema/access.sql text eol=lf
data/schema/runtime.sql text eol=lf
data/schema/modules-settings.sql text eol=lf
data/schema/conversations.sql text eol=lf
data/schema/openai.sql text eol=lf
data/schema/messaging.sql text eol=lf

# Module archives lock exact bytes across Windows and Linux. Text sources use LF;
# binary assets retain their original bytes and are not normalized by packaging.
extensions/**/*.ts text eol=lf
extensions/**/*.tsx text eol=lf
extensions/**/*.mjs text eol=lf
extensions/**/*.json text eol=lf
extensions/**/*.md text eol=lf
extensions/**/*.css text eol=lf
extensions/**/*.html text eol=lf
extensions/**/*.txt text eol=lf
extensions/**/LICENSE text eol=lf
themes/**/*.ts text eol=lf
themes/**/*.tsx text eol=lf
themes/**/*.mjs text eol=lf
themes/**/*.json text eol=lf
themes/**/*.md text eol=lf
themes/**/*.css text eol=lf
themes/**/LICENSE text eol=lf
tests/workspace/fixtures/module-witness/** text eol=lf
tests/runtime/fixtures/module-witness/** text eol=lf
