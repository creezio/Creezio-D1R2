{
  "schemaVersion": "1.0.0",
  "identity": {
    "id": "creezio.delivery",
    "title": "Livraison Cloudflare locale",
    "publisher": "creezio",
    "origin": "https://github.com/creezio/Creezio-D1R2",
    "version": "0.0.0",
    "source": {
      "kind": "snapshot",
      "revision": "t32-local-delivery-v1",
      "integrity": "sha256-b0aa38d3948972d4978593cf9c40fc8ce2dafc42b597f2cedcd4b08d128853e8"
    },
    "license": {
      "expression": "NOASSERTION",
      "file": "LICENSE"
    }
  },
  "compatibility": {
    "core": "^0.0.0",
    "sdk": "^1.1.0",
    "requiredCapabilities": [
      "runtime.worker"
    ],
    "optionalCapabilities": []
  },
  "entrypoints": {
    "server": {
      "path": "module/entry.server.ts",
      "export": "delivery"
    },
    "ui": {
      "path": "ui/index.tsx",
      "export": "DeliveryAdminView"
    },
    "plugin": {
      "manifest": "plugin/plugin.json",
      "mcp": "plugin/mcp.json",
      "contributions": {
        "path": "plugin/contributions.ts",
        "export": "contributions"
      }
    }
  },
  "dependencies": [],
  "contracts": {
    "schemas": [
      {
        "id": "empty-input",
        "schema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      {
        "id": "panel-state",
        "schema": {
          "type": "object",
          "properties": {
            "owner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "transferId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "planDigest": {
              "type": "string",
              "pattern": "^sha256-[a-f0-9]{64}$"
            },
            "started": {
              "type": "boolean"
            },
            "initial": {
              "type": "object",
              "properties": {
                "owner": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "transferId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "planDigest": {
                  "type": "string",
                  "pattern": "^sha256-[a-f0-9]{64}$"
                },
                "started": {
                  "type": "boolean"
                }
              },
              "required": [
                "owner",
                "transferId",
                "planDigest",
                "started"
              ],
              "additionalProperties": false
            },
            "update": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "update"
                },
                "owner": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "updateId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "planDigest": {
                  "type": "string",
                  "pattern": "^sha256-[a-f0-9]{64}$"
                },
                "started": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind",
                "owner",
                "updateId",
                "planDigest",
                "started"
              ],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        }
      }
    ],
    "models": [],
    "files": [],
    "events": [],
    "settings": [],
    "search": [],
    "permissions": [
      {
        "id": "manage",
        "title": "Gérer la livraison locale",
        "audiences": [
          "admin"
        ],
        "actors": [
          "user"
        ],
        "scopes": [
          "delivery.manage"
        ],
        "context": "application",
        "default": "deny",
        "resources": [],
        "actions": [
          "read",
          "configure",
          "execute"
        ],
        "enforcement": {
          "request": true,
          "commit": true
        },
        "public": false
      }
    ],
    "operations": [],
    "api": [],
    "mcp": {
      "tools": [],
      "resources": [],
      "prompts": [],
      "skills": []
    },
    "ui": {
      "views": [
        {
          "id": "admin",
          "title": "Livraison Cloudflare",
          "surfaces": [
            "workspace"
          ],
          "route": "/admin/delivery",
          "component": {
            "path": "ui/index.tsx",
            "export": "DeliveryAdminView"
          },
          "permissions": [
            {
              "moduleId": "creezio.delivery",
              "kind": "permission",
              "id": "manage"
            }
          ],
          "operations": [],
          "input": {
            "schemaId": "empty-input"
          },
          "panel": {
            "identityFields": [],
            "navigation": "sdk",
            "retention": "preserve",
            "inactiveEffects": "suspend",
            "stateSchema": {
              "schemaId": "panel-state"
            }
          }
        }
      ],
      "navigation": [
        {
          "id": "delivery",
          "title": "Livraison Cloudflare",
          "view": {
            "moduleId": "creezio.delivery",
            "kind": "view",
            "id": "admin"
          },
          "permissions": [
            {
              "moduleId": "creezio.delivery",
              "kind": "permission",
              "id": "manage"
            }
          ],
          "surfaces": [
            "workspace"
          ],
          "order": 50
        }
      ],
      "slots": [],
      "front": {
        "mode": "absent",
        "justification": {
          "reason": "Delivery is local admin-only.",
          "policyRule": "delivery.local-admin-only"
        }
      },
      "themes": [],
      "styles": []
    },
    "widgets": [],
    "publicContracts": []
  },
  "documentation": {
    "installed": {
      "readme": {
        "path": "README.md",
        "visibility": "public",
        "artifact": "runtime"
      },
      "prd": {
        "path": "prd.md",
        "visibility": "public",
        "artifact": "runtime"
      },
      "changelog": {
        "path": "CHANGELOG.md",
        "visibility": "public",
        "artifact": "runtime"
      }
    },
    "development": {
      "agents": {
        "path": "AGENTS.md",
        "visibility": "restricted",
        "artifact": "validation"
      },
      "files": {
        "path": "FILES.md",
        "visibility": "restricted",
        "artifact": "validation"
      },
      "interview": {
        "path": "interview.md",
        "visibility": "restricted",
        "artifact": "validation"
      },
      "todo": {
        "path": "TODO.md",
        "visibility": "restricted",
        "artifact": "validation"
      }
    },
    "versionBinding": {
      "moduleVersion": "0.0.0",
      "sourceRevision": "t32-local-delivery-v1"
    },
    "localRevisions": {
      "installedVersionDistinct": true,
      "approvedImmutable": true
    },
    "installationHistory": {
      "distinctFromPackageChangelog": true
    }
  },
  "validation": {
    "gate": "gate.mjs",
    "suites": {
      "backend": {
        "mode": "required",
        "script": "ci/backend.mjs",
        "tests": [
          "tests/backend/contract.test.mjs"
        ]
      },
      "ui": {
        "mode": "required",
        "script": "ci/ui.mjs",
        "tests": [
          "tests/ui/contract.test.mjs"
        ]
      },
      "api-mcp": {
        "mode": "not-applicable",
        "script": "ci/api-mcp.mjs",
        "tests": [
          "tests/api-mcp/contract.test.mjs"
        ],
        "justification": {
          "reason": "Publishing uses the native local operator, never a module operation or MCP tool.",
          "policyRule": "delivery.no-api-mcp"
        }
      },
      "widgets": {
        "mode": "not-applicable",
        "script": "ci/widgets.mjs",
        "tests": [
          "tests/widgets/contract.test.mjs"
        ],
        "justification": {
          "reason": "Delivery has no widget surface.",
          "policyRule": "delivery.no-widgets"
        }
      },
      "package": {
        "mode": "required",
        "script": "ci/package.mjs",
        "tests": [
          "tests/package/contract.test.mjs"
        ]
      },
      "docs": {
        "mode": "required",
        "script": "ci/docs.mjs",
        "tests": [
          "tests/docs/contract.test.mjs"
        ]
      }
    },
    "policy": {
      "id": "creezio.local-contracts",
      "version": "1.0.0",
      "integrity": "sha256-469b93af15a6dd7066e767f45af8587e613ee2f080d142ed076b00613acb5dfd"
    },
    "isolation": {
      "productionSecrets": false,
      "publicationRights": false
    },
    "evidence": {
      "sourceIntegrity": true,
      "artifactIntegrity": true,
      "profile": true,
      "executedSuites": true
    }
  },
  "packaging": {
    "runtime": {
      "files": [
        "module/manifest.json",
        "module/entry.server.ts",
        "ui/index.tsx",
        "ui/presentation.tsx",
        "ui/persistence.ts",
        "README.md",
        "prd.md",
        "CHANGELOG.md",
        "LICENSE",
        "plugin/plugin.json",
        "plugin/mcp.json",
        "plugin/contributions.ts"
      ],
      "references": []
    },
    "validation": {
      "files": [
        "AGENTS.md",
        "FILES.md",
        "interview.md",
        "TODO.md",
        "gate.mjs",
        "module/generate-manifest.mjs",
        "ci/run-suite.mjs",
        "ci/backend.mjs",
        "tests/backend/contract.test.mjs",
        "ci/ui.mjs",
        "tests/ui/contract.test.mjs",
        "ci/api-mcp.mjs",
        "tests/api-mcp/contract.test.mjs",
        "ci/widgets.mjs",
        "tests/widgets/contract.test.mjs",
        "ci/package.mjs",
        "tests/package/contract.test.mjs",
        "ci/docs.mjs",
        "tests/docs/contract.test.mjs"
      ],
      "references": []
    },
    "validationBinding": {
      "moduleId": "creezio.delivery",
      "moduleVersion": "0.0.0",
      "sourceRevision": "t32-local-delivery-v1"
    },
    "noRuntimeTests": true,
    "installation": "build-and-publish",
    "providerInstallation": false
  },
  "lifecycle": {
    "deactivation": "preserve-data",
    "configuration": "explicit-state",
    "uninstall": "explicit-approved-action",
    "activationRequirements": [],
    "absent": {
      "models": {
        "reason": "The local operator owns transfer state outside application D1.",
        "policyRule": "delivery.no-models"
      },
      "files": {
        "reason": "Transfer data stays in the local operator, not module file categories.",
        "policyRule": "delivery.no-files"
      },
      "widgets": {
        "reason": "Delivery is an administrative workspace view.",
        "policyRule": "delivery.no-widgets"
      }
    },
    "dependencyChanges": {
      "install": "resolve-explicit-consumer-selection",
      "activate": "require-active-dependencies",
      "update": "validate-dependent-contracts",
      "deactivate": "block-or-explicit-dependent-plan",
      "uninstall": "block-or-explicit-dependent-plan",
      "data": "preserve"
    }
  }
}
