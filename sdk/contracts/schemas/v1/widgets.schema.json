{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:creezio:contracts:v1:widgets",
  "title": "Creezio widgets v1",
  "description": "Multiple widget types and instances; message/context/direct is selected per action. Metadata validation does not prove host integration.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "$ref": "urn:creezio:contracts:v1:common#/$defs/id"
      },
      "version": {
        "$ref": "urn:creezio:contracts:v1:common#/$defs/version"
      },
      "compatibility": {
        "$ref": "urn:creezio:contracts:v1:common#/$defs/versionRange"
      },
      "resource": {
        "$ref": "urn:creezio:contracts:v1:common#/$defs/id"
      },
      "renderer": {
        "$ref": "urn:creezio:contracts:v1:common#/$defs/codeRef"
      },
      "input": {
        "$ref": "urn:creezio:contracts:v1:common#/$defs/schemaRef"
      },
      "state": {
        "$ref": "urn:creezio:contracts:v1:common#/$defs/schemaRef"
      },
      "result": {
        "$ref": "urn:creezio:contracts:v1:common#/$defs/schemaRef"
      },
      "audiences": {
        "type": "array",
        "items": {
          "$ref": "urn:creezio:contracts:v1:common#/$defs/audience"
        },
        "minItems": 1,
        "maxItems": 2
      },
      "permissions": {
        "type": "array",
        "items": {
          "$ref": "urn:creezio:contracts:v1:common#/$defs/contractRef"
        },
        "minItems": 0,
        "maxItems": 1000
      },
      "requiredCapabilities": {
        "type": "array",
        "items": {
          "$ref": "urn:creezio:contracts:v1:common#/$defs/capability"
        },
        "minItems": 0,
        "maxItems": 1000
      },
      "assets": {
        "type": "array",
        "items": {
          "$ref": "urn:creezio:contracts:v1:common#/$defs/filePath"
        },
        "minItems": 0,
        "maxItems": 1000
      },
      "actions": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "urn:creezio:contracts:v1:common#/$defs/id"
                },
                "label": {
                  "$ref": "urn:creezio:contracts:v1:common#/$defs/text"
                },
                "input": {
                  "$ref": "urn:creezio:contracts:v1:common#/$defs/schemaRef"
                },
                "requiredCapabilities": {
                  "type": "array",
                  "items": {
                    "$ref": "urn:creezio:contracts:v1:common#/$defs/capability"
                  },
                  "minItems": 0,
                  "maxItems": 1000
                },
                "fallback": {
                  "type": "string",
                  "enum": [
                    "unavailable",
                    "copy-message",
                    "local-untransmitted-context"
                  ]
                },
                "mode": {
                  "const": "message"
                },
                "target": {
                  "type": "object",
                  "properties": {
                    "template": {
                      "$ref": "urn:creezio:contracts:v1:common#/$defs/filePath"
                    },
                    "preview": {
                      "const": true
                    },
                    "voluntarySend": {
                      "const": true
                    },
                    "states": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "proposed",
                          "transmitted",
                          "refused",
                          "unknown"
                        ]
                      },
                      "minItems": 4,
                      "maxItems": 4
                    }
                  },
                  "required": [
                    "template",
                    "preview",
                    "voluntarySend",
                    "states"
                  ],
                  "additionalProperties": false
                },
                "requiresModules": {
                  "type": "array",
                  "items": {
                    "$ref": "urn:creezio:contracts:v1:common#/$defs/id"
                  },
                  "minItems": 1,
                  "maxItems": 1000,
                  "uniqueItems": true,
                  "description": "Optional dependency guards for this action only. A disabled parent widget disables all actions; disabling this action preserves its sibling actions and widget."
                }
              },
              "required": [
                "id",
                "label",
                "input",
                "requiredCapabilities",
                "fallback",
                "mode",
                "target"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "urn:creezio:contracts:v1:common#/$defs/id"
                },
                "label": {
                  "$ref": "urn:creezio:contracts:v1:common#/$defs/text"
                },
                "input": {
                  "$ref": "urn:creezio:contracts:v1:common#/$defs/schemaRef"
                },
                "requiredCapabilities": {
                  "type": "array",
                  "items": {
                    "$ref": "urn:creezio:contracts:v1:common#/$defs/capability"
                  },
                  "minItems": 0,
                  "maxItems": 1000
                },
                "fallback": {
                  "type": "string",
                  "enum": [
                    "unavailable",
                    "copy-message",
                    "local-untransmitted-context"
                  ]
                },
                "mode": {
                  "const": "context"
                },
                "target": {
                  "type": "object",
                  "properties": {
                    "namespace": {
                      "const": "module-instance"
                    },
                    "fields": {
                      "type": "array",
                      "items": {
                        "$ref": "urn:creezio:contracts:v1:common#/$defs/id"
                      },
                      "minItems": 1,
                      "maxItems": 1000
                    },
                    "scope": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "actor",
                          "conversation",
                          "surface"
                        ]
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "expiresAfterSeconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 604800
                    },
                    "replace": {
                      "const": true
                    },
                    "removable": {
                      "const": true
                    },
                    "revisionField": {
                      "$ref": "urn:creezio:contracts:v1:common#/$defs/id"
                    }
                  },
                  "required": [
                    "namespace",
                    "fields",
                    "scope",
                    "expiresAfterSeconds",
                    "replace",
                    "removable",
                    "revisionField"
                  ],
                  "additionalProperties": false
                },
                "requiresModules": {
                  "type": "array",
                  "items": {
                    "$ref": "urn:creezio:contracts:v1:common#/$defs/id"
                  },
                  "minItems": 1,
                  "maxItems": 1000,
                  "uniqueItems": true,
                  "description": "Optional dependency guards for this action only. A disabled parent widget disables all actions; disabling this action preserves its sibling actions and widget."
                }
              },
              "required": [
                "id",
                "label",
                "input",
                "requiredCapabilities",
                "fallback",
                "mode",
                "target"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "urn:creezio:contracts:v1:common#/$defs/id"
                },
                "label": {
                  "$ref": "urn:creezio:contracts:v1:common#/$defs/text"
                },
                "input": {
                  "$ref": "urn:creezio:contracts:v1:common#/$defs/schemaRef"
                },
                "requiredCapabilities": {
                  "type": "array",
                  "items": {
                    "$ref": "urn:creezio:contracts:v1:common#/$defs/capability"
                  },
                  "minItems": 0,
                  "maxItems": 1000
                },
                "fallback": {
                  "type": "string",
                  "enum": [
                    "unavailable",
                    "copy-message",
                    "local-untransmitted-context"
                  ]
                },
                "mode": {
                  "const": "direct"
                },
                "target": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "local"
                        },
                        "handler": {
                          "$ref": "urn:creezio:contracts:v1:common#/$defs/codeRef"
                        },
                        "effect": {
                          "const": "visual-only"
                        }
                      },
                      "required": [
                        "kind",
                        "handler",
                        "effect"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "operation"
                        },
                        "operation": {
                          "$ref": "urn:creezio:contracts:v1:common#/$defs/contractRef"
                        }
                      },
                      "required": [
                        "kind",
                        "operation"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "afterSuccessContext": {
                  "type": "object",
                  "properties": {
                    "namespace": {
                      "const": "module-instance"
                    },
                    "fields": {
                      "type": "array",
                      "items": {
                        "$ref": "urn:creezio:contracts:v1:common#/$defs/id"
                      },
                      "minItems": 1,
                      "maxItems": 1000
                    },
                    "scope": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "actor",
                          "conversation",
                          "surface"
                        ]
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "expiresAfterSeconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 604800
                    },
                    "replace": {
                      "const": true
                    },
                    "removable": {
                      "const": true
                    },
                    "revisionField": {
                      "$ref": "urn:creezio:contracts:v1:common#/$defs/id"
                    }
                  },
                  "required": [
                    "namespace",
                    "fields",
                    "scope",
                    "expiresAfterSeconds",
                    "replace",
                    "removable",
                    "revisionField"
                  ],
                  "additionalProperties": false
                },
                "requiresModules": {
                  "type": "array",
                  "items": {
                    "$ref": "urn:creezio:contracts:v1:common#/$defs/id"
                  },
                  "minItems": 1,
                  "maxItems": 1000,
                  "uniqueItems": true,
                  "description": "Optional dependency guards for this action only. A disabled parent widget disables all actions; disabling this action preserves its sibling actions and widget."
                }
              },
              "required": [
                "id",
                "label",
                "input",
                "requiredCapabilities",
                "fallback",
                "mode",
                "target"
              ],
              "additionalProperties": false
            }
          ]
        },
        "minItems": 1,
        "maxItems": 1000
      },
      "instance": {
        "type": "object",
        "properties": {
          "identity": {
            "const": "host-generated"
          },
          "revision": {
            "const": "monotonic"
          },
          "correlation": {
            "const": "request-instance-conversation"
          },
          "objectVersion": {
            "const": "distinct"
          },
          "lateResponse": {
            "const": "reject-stale"
          }
        },
        "required": [
          "identity",
          "revision",
          "correlation",
          "objectVersion",
          "lateResponse"
        ],
        "additionalProperties": false
      },
      "transport": {
        "type": "object",
        "properties": {
          "protocol": {
            "const": "mcp-apps"
          },
          "maxPayloadBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120000
          },
          "uncertainResult": {
            "const": "reconcile-before-retry"
          },
          "fallbackDispatch": {
            "const": "before-first-dispatch-only"
          }
        },
        "required": [
          "protocol",
          "maxPayloadBytes",
          "timeoutMs",
          "uncertainResult",
          "fallbackDispatch"
        ],
        "additionalProperties": false
      },
      "requiresModules": {
        "type": "array",
        "items": {
          "$ref": "urn:creezio:contracts:v1:common#/$defs/id"
        },
        "minItems": 1,
        "maxItems": 1000,
        "uniqueItems": true,
        "description": "Optional dependency guards. Every ID must be declared optional; the contribution is unavailable while any guarded module is absent or inactive."
      }
    },
    "required": [
      "id",
      "version",
      "compatibility",
      "resource",
      "renderer",
      "input",
      "state",
      "result",
      "audiences",
      "permissions",
      "requiredCapabilities",
      "assets",
      "actions",
      "instance",
      "transport"
    ],
    "additionalProperties": false
  },
  "minItems": 0,
  "maxItems": 1000
}
