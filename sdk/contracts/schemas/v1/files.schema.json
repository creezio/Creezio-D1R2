{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:creezio:contracts:v1:files",
  "title": "Creezio files v1",
  "description": "File categories stored by the host adapter; permissions apply to metadata and content.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "$ref": "urn:creezio:contracts:v1:common#/$defs/id"
      },
      "metadataModel": {
        "$ref": "urn:creezio:contracts:v1:common#/$defs/contractRef"
      },
      "ownerField": {
        "$ref": "urn:creezio:contracts:v1:common#/$defs/id"
      },
      "ownerScope": {
        "description": "File owner identity: principal shared between audiences, or historical principal-audience isolation when omitted.",
        "type": "string",
        "enum": ["principal", "principal-audience"]
      },
      "linkedRead": {
        "description": "Authenticated read of a file linked to a same-module record in a declared state. Does not authorize upload, deletion or ordinary owner reads.",
        "type": "object",
        "properties": {
          "audiences": {"type":"array","items":{"enum":["admin","app"]},"minItems":1,"maxItems":2,"uniqueItems":true},
          "permission": {"$ref":"urn:creezio:contracts:v1:common#/$defs/contractRef"},
          "linkModel": {"$ref":"urn:creezio:contracts:v1:common#/$defs/contractRef"},
          "parentRelation": {"$ref":"urn:creezio:contracts:v1:common#/$defs/id"},
          "referenceFields": {
            "type":"object",
            "properties": {
              "fileId":{"$ref":"urn:creezio:contracts:v1:common#/$defs/id"},
              "intentId":{"$ref":"urn:creezio:contracts:v1:common#/$defs/id"},
              "generation":{"$ref":"urn:creezio:contracts:v1:common#/$defs/id"},
              "digest":{"$ref":"urn:creezio:contracts:v1:common#/$defs/id"}
            },
            "required":["fileId","intentId","generation","digest"],"additionalProperties":false
          },
          "when": {
            "type":"object",
            "properties": {
              "field":{"$ref":"urn:creezio:contracts:v1:common#/$defs/id"},
              "equals":{"type":"string","minLength":1,"maxLength":128}
            },
            "required":["field","equals"],"additionalProperties":false
          }
        },
        "required":["audiences","permission","linkModel","parentRelation","referenceFields","when"],
        "additionalProperties":false
      },
      "contextField": {
        "$ref": "urn:creezio:contracts:v1:common#/$defs/id"
      },
      "storageFields": {
        "type": "object",
        "description": "Explicit protected columns of this category's private metadata model; no column names are inferred.",
        "properties": {
          "id": { "$ref": "urn:creezio:contracts:v1:common#/$defs/id" },
          "objectKey": { "$ref": "urn:creezio:contracts:v1:common#/$defs/id" },
          "digest": { "$ref": "urn:creezio:contracts:v1:common#/$defs/id" },
          "byteSize": { "$ref": "urn:creezio:contracts:v1:common#/$defs/id" },
          "contentType": { "$ref": "urn:creezio:contracts:v1:common#/$defs/id" },
          "filename": { "$ref": "urn:creezio:contracts:v1:common#/$defs/id" },
          "version": { "$ref": "urn:creezio:contracts:v1:common#/$defs/id" },
          "state": { "$ref": "urn:creezio:contracts:v1:common#/$defs/id" },
          "intentId": { "$ref": "urn:creezio:contracts:v1:common#/$defs/id" },
          "generation": { "$ref": "urn:creezio:contracts:v1:common#/$defs/id" }
        },
        "required": ["id", "objectKey", "digest", "byteSize", "contentType", "filename", "version", "state", "intentId", "generation"],
        "additionalProperties": false
      },
      "mimeTypes": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "minItems": 1,
        "maxItems": 1000
      },
      "maxBytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "permissions": {
        "type": "array",
        "items": {
          "$ref": "urn:creezio:contracts:v1:common#/$defs/contractRef"
        },
        "minItems": 0,
        "maxItems": 1000
      },
      "attachment": {
        "type": "object",
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "$ref": "urn:creezio:contracts:v1:common#/$defs/contractRef"
            },
            "minItems": 0,
            "maxItems": 1000
          },
          "multiple": {
            "type": "boolean"
          }
        },
        "required": [
          "models",
          "multiple"
        ],
        "additionalProperties": false
      },
      "deletion": {
        "type": "string",
        "enum": [
          "restrict",
          "detach",
          "delete-with-owner"
        ]
      },
      "public": {
        "type": "boolean"
      }
    },
    "required": [
      "id",
      "metadataModel",
      "ownerField",
      "contextField",
      "storageFields",
      "mimeTypes",
      "maxBytes",
      "permissions",
      "attachment",
      "deletion",
      "public"
    ],
    "additionalProperties": false
  },
  "minItems": 0,
  "maxItems": 1000
}
